# Run from RootLink/embedded/rv1106. Replace TTS_VOICE before use.
TARGET=simulator
UI_BACKEND=sdl
UI_WIDTH=320
UI_HEIGHT=240
UI_TEXT_INTERVAL_MS=50
UI_PAGE_HOLD_MS=2000
AUDIO_API=alsa
SERVICE_MODE=cloud
CAPTURE_DEVICE=pulse
PLAYBACK_DEVICE=pulse
MODELS_FILE=config/models.json
SECRETS_FILE=config/rootlink-secrets.env
ROLE_DIR=../../characters/kurisu_amadeus
SESSION_DIR=build/windows-cloud/kurisu-sessions
PERSONA_BACKEND=python
PYTHON_EXECUTABLE=../../.venv/bin/python
PYTHON_CORE_ENTRY=scripts/persona-worker.py
# Same saved persona as the current local UI configuration; no new personality.
PYTHON_DATA_DIR=build/windows-cloud/kurisu-canon-python-data
PERSONA_START_TIMEOUT_MS=30000
PERSONA_TURN_TIMEOUT_MS=300000
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://api.deepseek.com
ASR_PROVIDER=dashscope
TTS_PROVIDER=dashscope
TTS_MODEL=cosyvoice-v3.5-plus
TTS_VOICE=YOUR_COSYVOICE_VOICE_ID
TTS_SAMPLE_RATE=16000
TTS_BASE_URL=https://dashscope.aliyuncs.com/api/v1
TTS_TRANSLATE_TO=ja
TTS_TRANSLATION_TIMEOUT_MS=60000
TTS_TIMEOUT_MS=60000
