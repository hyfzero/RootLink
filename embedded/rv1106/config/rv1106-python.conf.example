TARGET=rv1106
UI_BACKEND=fbdev
UI_DEVICE=/dev/fb0
# DeskBot reference uses event0; adjust to the board's touchscreen event node.
UI_INPUT_DEVICE=/dev/input/event0
AUDIO_API=alsa
SERVICE_MODE=cloud
CAPTURE_DEVICE=default
PLAYBACK_DEVICE=default
PERSONA_BACKEND=python
PYTHON_EXECUTABLE=/usr/bin/python3.11
PYTHON_CORE_ENTRY=/opt/rootlink/persona-worker.py
PYTHON_DATA_DIR=/data/rootlink/python-data
ROLE_DIR=/opt/rootlink/role-seed
SESSION_DIR=/data/rootlink/sessions
MODELS_FILE=/data/rootlink/config/models.json
SECRETS_FILE=/etc/rootlink/rootlink-secrets.env
PERSONA_START_TIMEOUT_MS=30000
PERSONA_TURN_TIMEOUT_MS=300000
LLM_PROVIDER=qwen
LLM_MODEL=qwen-plus
ASR_PROVIDER=dashscope
TTS_PROVIDER=dashscope
TTS_MODEL=cosyvoice-v3-flash
TTS_VOICE=longanyang
TTS_SAMPLE_RATE=16000
